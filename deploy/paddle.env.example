# /opt/namecard/secrets/paddle.env on the server (root, mode 600). Real values never go in this repo.
# Which Paddle account the site uses: sandbox or live. Change it, then: sudo systemctl restart namecard-pb
PADDLE_ENV=sandbox
# Client-side token (test_… for sandbox, live_… for live). Public by design; sent to browsers.
PADDLE_CLIENT_TOKEN=
# Price IDs (pri_…) of the account above.
PADDLE_PRICE_PRO=
PADDLE_PRICE_SHARE_PACK=
# Signing secret (endpoint_secret_key) of that account's notification destination for
# https://api.1name.cards/api/paddle/webhook
PADDLE_WEBHOOK_SECRET=
