# /opt/namecard/secrets/creem.env on the server (root, mode 600). Real values never go in this repo.
# creem picks Creem as the payment provider; anything else (or no file) keeps Paddle.
PAYMENTS=creem
# API key from https://creem.io/dashboard/developers. creem_test_… = test mode, otherwise live.
CREEM_API_KEY=
# Product IDs (prod_…) in the same mode as the key.
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_SHARE_PACK=
# Signing secret of the webhook for https://api.1name.cards/api/creem/webhook
CREEM_WEBHOOK_SECRET=
